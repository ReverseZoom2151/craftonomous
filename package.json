{
  "name": "craftonomous",
  "version": "0.0.1",
  "description": "An agent-agnostic Minecraft embodiment and evaluation substrate: an MCP-native body with a declared perception budget and reliability-tracked skills.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReverseZoom2151/craftonomous.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./dist/index.js",
    "./agent": "./dist/agent/index.js",
    "./embodiment": "./dist/embodiment/index.js",
    "./eval": "./dist/eval/index.js",
    "./mcp": "./dist/mcp/index.js",
    "./planning": "./dist/planning/index.js",
    "./sandbox": "./dist/sandbox/index.js",
    "./skills": "./dist/skills/library/index.js"
  },
  "bin": {
    "craftonomous": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:build": "npm run build && node scripts/smoke.mjs",
    "test:live": "vitest run --config tests/live/vitest.config.ts",
    "mc:up": "docker compose -f docker/docker-compose.yml up -d",
    "mc:down": "docker compose -f docker/docker-compose.yml down",
    "mc:reset": "docker compose -f docker/docker-compose.yml down -v",
    "mc:logs": "docker compose -f docker/docker-compose.yml logs -f minecraft"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "minecraft-data": "^3.108.0",
    "mineflayer": "^4.37.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-block": "^1.21.0",
    "prismarine-entity": "^2.5.0",
    "vec3": "^0.1.10",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.7.0",
    "vitest": "^2.1.0"
  }
}
