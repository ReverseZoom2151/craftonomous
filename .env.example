# Craftonomous environment variables.
#
# Copy to `.env` and edit. `.env` is git-ignored; this file is not, so never
# put real credentials here.
#
#   cp .env.example .env
#
# Read SECURITY.md before pointing this at anything. The MCP server hands
# game actions to an LLM that reads attacker-controlled in-game text, so only
# run it against a server you control.

# ---------------------------------------------------------------------------
# Minecraft connection
# ---------------------------------------------------------------------------

# Hostname or IP of the server the bot joins.
# Use a local or private server. Default: 127.0.0.1
MINECRAFT_HOST=127.0.0.1

# Server port. Default: 25565
MINECRAFT_PORT=25565

# In-game name the bot connects as. With offline auth this is just a label;
# with microsoft auth it must match the account.
MINECRAFT_USERNAME=craftonomous

# Protocol version to speak, e.g. 1.21.1. Leave unset to auto-detect from the
# server handshake. Pin it if auto-detection picks the wrong one.
MINECRAFT_VERSION=

# Authentication mode: offline | microsoft
#   offline   - no account, cracked/LAN servers only. Use this for development.
#   microsoft - real Microsoft account; an interactive device-code login is
#               triggered on first connect. Never commit the resulting cache.
MINECRAFT_AUTH=offline

# ---------------------------------------------------------------------------
# Craftonomous behaviour
# ---------------------------------------------------------------------------

# Perception profile: fair-play | xray | omniscient
#
# Declares the agent's perception budget: what it is allowed to know.
#   fair-play  - only what a human player at the same position could perceive.
#                The honest default; use this for any reported result.
#   xray       - block knowledge through occlusion. Ablation only.
#   omniscient - full world state, no line-of-sight or distance limits.
#                Ablation and debugging only.
#
# These are honesty settings, not security controls: they change what the
# agent knows, never what it is permitted to do. Any run not using fair-play
# must say so when its results are reported.
CRAFTONOMOUS_PROFILE=fair-play

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

# Log verbosity: debug | info | warn | error
# Default: info. Use debug when filing a bug report.
LOG_LEVEL=info
